# =====================================================================
#  LEXUR · Landing Web — reglas de .gitignore
# =====================================================================

# ---------- Dependencias ----------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------- Build de Next.js ----------
/.next/
/out/
/build
/dist

# ---------- TypeScript (generados) ----------
*.tsbuildinfo
next-env.d.ts

# ---------- Pruebas (Playwright / cobertura) ----------
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# ---------- Variables de entorno (secretos) ----------
.env
.env*
!.env.example

# ---------- Cloudflare / OpenNext ----------
.open-next/
.wrangler/
.dev.vars

# ---------- Vercel ----------
.vercel

# ---------- Logs y depuración ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------- Certificados / llaves ----------
*.pem
*.key

# ---------- Herramientas locales (no forman parte del sitio) ----------
# Graphify (LPX-96): se versiona el grafo (graph.json, GRAPH_REPORT.md, graph.html)
# pero no la caché ni archivos con rutas/estado de cada máquina
graphify-out/cache/
graphify-out/manifest.json
graphify-out/cost.json
graphify-out/.graphify_root
graphify-out/.graphify_python
graphify-out/.cloud-cta-shown
# Scripts personales de conversión md -> docx/pdf (rutas locales de Windows)
convert.js
convert_qa.js
# Documentos exportados
*.docx
*.pdf

# ---------- Capturas y archivos temporales ----------
screenshot_*.png
*.tmp
*.bak
*~

# ---------- Sistema operativo ----------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------- Editores / IDE ----------
.idea/
*.swp
*.swo
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
